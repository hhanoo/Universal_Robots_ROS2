<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <!-- ================================================= -->
  <!-- 1. Wrapper identity                               -->
  <!-- 로봇 전체 name (URDF robot name, prefix 아님)        -->
  <!-- include된 ur_description의 name arg를 override함    -->
  <!-- ================================================= -->
  <xacro:arg name="name" default="ur_robot_wrapper"/>

  <!-- ================================================= -->
  <!-- 2. UR model selection                             -->
  <!-- 가능한 값: ur3, ur5, ur10, ur3e, ur5e, ur10e 등     -->
  <!-- 이 값은 include된 ur_description에서 소비됨           -->
  <!-- ================================================= -->
  <xacro:arg name="ur_type" default="ur10e"/>

  <!-- ================================================= -->
  <!-- 3. Calibration / limits (passthrough)             -->
  <!-- ================================================= -->
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>

  <!-- ================================================= -->
  <!-- 4. Control-related args (passthrough)             -->
  <!-- description wrapper에서는 직접 사용하지 않음           -->
  <!-- include된 ur_description/ur.urdf.xacro에서 사용됨    -->
  <!-- control/bringup/ros2_control과 arg 일관성 유지 목적   -->
  <!-- ================================================= -->
  <xacro:arg name="robot_ip" default="127.0.0.1"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="headless_mode" default="true"/>

  <!-- ================================================= -->
  <!-- 5. Include official UR description                -->
  <!-- 이 include는 하위 파일의 동일 arg default를 덮어씀      -->
  <!-- (xacro arg는 먼저 정의된 값이 우선)                    -->
  <!-- ================================================= -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- ================================================= -->
  <!-- 6. Custom extension area (OPTIONAL)               -->
  <!-- 이 영역에서 추가한 link/joint는                       -->
  <!-- - TF tree                                         -->
  <!-- - FK / IK 결과                                     -->
  <!-- - MoveIt planning frame                           -->
  <!-- 에 직접적인 영향을 줌                                 -->
  <!-- ================================================= -->
  <!--
  ============================
  Example 1: Fixed TCP offset
  TCP 고정 오프셋 예시
  ============================

  <xacro:property name="tcp_x" value="0.0"/>
  <xacro:property name="tcp_y" value="0.0"/>
  <xacro:property name="tcp_z" value="0.180"/>

  <link name="tool_link"/>

  <joint name="tool0_to_tool_link" type="fixed">
    <parent link="tool0"/>
    <child link="tool_link"/>
    <origin xyz="${tcp_x} ${tcp_y} ${tcp_z}" rpy="0 0 0"/>
  </joint>


  ============================
  Example 2: Custom gripper
  그리퍼 링크 추가 예시
  ============================

  <link name="gripper_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.1"/>
      </geometry>
    </visual>
  </link>

  <joint name="tool0_to_gripper" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>


  ============================
  Example 3: Camera mount
  카메라 장착 예시
  ============================

  <link name="camera_link"/>

  <joint name="tool0_to_camera" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.20" rpy="0 0 0"/>
  </joint>


  ============================
  Example 4: Multiple TCPs
  여러 TCP 구조 예시
  ============================

  <link name="tcp_pick"/>
  <joint name="tool0_to_tcp_pick" type="fixed">
    <parent link="tool0"/>
    <child link="tcp_pick"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="tcp_place"/>
  <joint name="tool0_to_tcp_place" type="fixed">
    <parent link="tool0"/>
    <child link="tcp_place"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>
  -->

  <!-- ================================================= -->
  <!-- End of custom extension area                      -->
  <!-- 커스텀 확장 영역 끝                                   -->
  <!-- ================================================= -->

</robot>
