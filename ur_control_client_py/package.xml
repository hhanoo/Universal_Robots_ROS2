<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_control_client_py</name>
  <version>1.0.0</version>
  <description>Python client library and examples for UR robot control (MoveJ, MoveL, I/O, Speed)</description>

  <maintainer email="woo980711@gmail.com">hhanoo</maintainer>
  
  <license>BSD-3-Clause</license>

  <!-- ========================================================= -->
  <!-- Core ROS2 dependencies -->
  <!-- ========================================================= -->
  <!-- * ROS 2 Python client library -->
  <depend>rclpy</depend>
  
  <!-- * UR Motion action interface -->
  <depend>ur_motion</depend>
  
  <!-- * UR-specific messages and services -->
  <depend>ur_msgs</depend>
  
  <!-- * Common message types -->
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- ========================================================= -->
  <!-- Test dependencies -->
  <!-- ========================================================= -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ========================================================= -->
  <!-- Export build type -->
  <!-- ========================================================= -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
