<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_robot_driver_wrapper</name>
  <version>0.0.0</version>
  <description>UR Driver Wrapper</description>

  <maintainer email="woo980711@gmail.com">hhanoo</maintainer>

  <license>BSD-3-Clause</license>

  <!-- ========================================================= -->
  <!-- Build tool dependencies (빌드 시스템 의존성) -->
  <!-- ========================================================= -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ========================================================= -->
  <!-- Core ROS2 dependencies (핵심 ROS2 의존성) -->
  <!-- ========================================================= -->
  <!-- * ROS 2 core client libraries (ROS 2 핵심 클라이언트 라이브러리) -->
  <depend>rclpy</depend>
  <!-- * Runtime dependencies for launch system (실행 시 필요한 의존성) -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <!-- * Controller manager dependency (컨트롤러 관리자 의존성) -->
  <depend>controller_manager</depend>
  <!-- * UR robot driver and description dependency (UR 로봇 드라이버 및 설명 의존성) -->
  <depend>ur_robot_driver</depend>
  <depend>ur_description</depend>

  <!-- ========================================================= -->
  <!-- Export build type (빌드 타입 명시) -->
  <!-- ========================================================= -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
