      <size>
        <width>1020</width>
        <height>860</height>
      </size>
    </property>
    <property name="windowTitle">
      <string>UR Motion Panel</string>
    </property>
    <property name="styleSheet">
      <string>#centralwidget { background: #eceff3; }
QGroupBox { background: #ffffff; border: 1px solid #d7dce3; border-radius: 6px; margin-top: 10px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #39414e; }
QLabel { background: transparent; }
QLabel[role="hdr"] { color: #8a93a1; }
QLabel[role="cap"] { color: #6a7482; }
QLabel#label_status { min-height: 44px; }
QCheckBox { color: #6a7482; spacing: 3px; }
QLineEdit { background: #ffffff; border: 1px solid #c9d0da; border-radius: 4px; padding: 2px 6px; color: #141a22; }
QLineEdit:read-only { background: #f4f6f8; }
QLineEdit[mode="live"] { color: #1e8449; }
QLineEdit[mode="run"] { color: #b9770e; }
QLineEdit[mode="off"] { color: #b4bbc6; }
QLineEdit, QSpinBox, QDoubleSpinBox { min-height: 30px; }
QPushButton { background: #ffffff; border: 1px solid #c9d0da; border-radius: 4px; padding: 4px 10px; color: #2b3340; min-height: 36px; }
QPushButton:hover:enabled { background: #f0f4fa; }
QPushButton:pressed { background: #e2e9f3; }
QPushButton:disabled { color: #b4bbc6; background: #f4f6f8; }
QPushButton#btn_moveJ, QPushButton#btn_moveL, QPushButton#btnRobotConnect { background: #2f6fd0; border: 1px solid #2f6fd0; color: white; font-weight: bold; }
QPushButton#btn_moveJ:hover:enabled, QPushButton#btn_moveL:hover:enabled, QPushButton#btnRobotConnect:hover:enabled { background: #2a63bb; }
QPushButton#btn_moveJ:disabled, QPushButton#btn_moveL:disabled { background: #f4f6f8; border: 1px solid #dde3ea; color: #b4bbc6; font-weight: normal; }
QPushButton#btn_moveJ, QPushButton#btn_moveL { min-height: 44px; }
QPushButton#btnRobotConnect { min-height: 44px; }
QPushButton#btn_stop { background: #c0392b; border: 1px solid #a93226; color: white; font-weight: bold; min-height: 44px; }
QPushButton#btn_stop:hover:enabled { background: #d64541; }
QPushButton#btn_stop:pressed { background: #a93226; }
QPushButton#btn_stop:disabled { background: #dcaaa4; border: 1px solid #d09b94; color: #f6e8e6; }</string>
    </property>
