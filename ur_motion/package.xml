<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_motion</name>
  <version>0.0.0</version>
  <description>UR Motion - High-level motion control interface</description>

  <maintainer email="woo980711@gmail.com">hhanoo</maintainer>
  
  <license>BSD-3-Clause</license>

  <!-- Build tool dependency (빌드 도구) -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build-time dependency for Action/Msg generation
       (Action/Msg 코드 생성 시 필요) -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- Runtime dependency for generated Action/Msg
       (실행 시 필요) -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Core ROS2 dependencies (핵심 ROS2 의존성) -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  
  <!-- Test dependencies (테스트용 의존성) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Mark this package as an interface package
       (Action/Msg/Srv 인터페이스 패키지임을 명시) -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Export build type (빌드 타입 명시) -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
